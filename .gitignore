# Secrets / identifiants (ne jamais committer)
.env
.env.*
*.local

# macOS
.DS_Store

# Éditeurs
.vscode/
.idea/

# Node
node_modules/

# Cache écrit par sitemap.php sur le serveur (jamais versionné)
sitemap-annonces-cache.xml*

# Espace de travail Claude Code (worktrees, réglages locaux)
.claude/

# Dépendances de test (Postgres embarqué, SDK Stripe, client pg)
node_modules/

# Secrets locaux fournis au processus de test, jamais versionnés
.secrets/

# Sauvegardes de base : contiennent des données personnelles réelles
backups/db/

# Traductions découpées par langue, écrites par build-i18n-dict.cjs depuis i18n.js
i18n-runtime.js
i18n-fr.js
i18n-en.js

# Feuille de style servie, écrite par build-css.cjs depuis style.css
style.min.css

# Carte du site pour les assistants, écrite par build-guides.cjs
llms.txt

# État propre à cette machine : images téléchargées par
# fabriquer-illustrations.py, illustrations déjà déposées (deploy-ovh.sh),
# empreintes des pages signalées à IndexNow (ping-indexnow.cjs)
.cache/

# Bytecode de fabriquer-illustrations.py
__pycache__/
