# ============================================================
# Athena Militaria — configuration serveur (Apache / OVH)
# Chaque bloc est protégé par <IfModule> : si un module n'est pas
# disponible sur l'hébergement, la règle est ignorée sans erreur 500.
# ============================================================

# ---- Page 404 personnalisée (évite la page d'erreur brute d'OVH) ----
ErrorDocument 404 /404.html

# ---- Pas de listing de répertoire ----
# Sans cette ligne, /pictures/ renvoie l'inventaire complet du dossier.
Options -Indexes

# ---- Coulisses du sitemap des annonces ----
# Le cache écrit par sitemap.php et la copie de secours déposée au déploiement
# sont des fichiers de travail. Servis directement, ils constitueraient un
# second sitemap, potentiellement périmé, que rien ne justifie d'exposer.
# Syntaxe Apache 2.4, protégée par IfModule : sur un serveur plus ancien la
# directive serait inconnue et renverrait une 500 sur tout le site.
<IfModule mod_authz_core.c>
  <FilesMatch "^sitemap-annonces-(cache|secours)\.xml">
    Require all denied
  </FilesMatch>
</IfModule>

# ---- Apache ne doit pas ajouter de slash final aux répertoires ----
# mod_dir redirige par défaut /guides vers /guides/. Combiné à notre règle de
# suppression du slash final, cela produisait une boucle de redirection sans
# fin sur l'index des guides. On lui retire la main : la réécriture ci-dessous
# sert elle-même le fichier d'index. Sans risque de listing, Options -Indexes
# étant actif juste au-dessus.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# ---- URLs propres : /account au lieu de /account.html ----
# Les fichiers restent nommés account.html sur le serveur, seule l'URL change.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Apache ne doit pas deviner l'extension tout seul : ça entrerait en conflit
  # avec la dernière règle et produirait des redirections imprévisibles.
  Options -MultiViews

  # 1. Une seule adresse canonique : https + www, en un seul saut.
  #
  #    ATTENTION : ne JAMAIS tester %{HTTPS} ici. Chez OVH le TLS est terminé
  #    en amont, Apache reçoit la requête en clair et %{HTTPS} vaut "off" même
  #    sur une visite en https : la règle boucherait à l'infini et le site
  #    entier deviendrait inaccessible.
  #    On teste donc l'en-tête transmis par le frontal, et uniquement sa valeur
  #    positive "http". Si l'en-tête est absent, aucune redirection n'a lieu :
  #    en cas d'imprévu on retombe sur le comportement actuel, jamais sur une
  #    boucle.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP_HOST} ^athenamilitaria\.fr$ [NC]
  RewriteRule ^ https://www.athenamilitaria.fr%{REQUEST_URI} [R=301,L]

  # 2. /index.html et /index renvoient vers la racine.
  #    URL absolue : le TLS étant terminé en amont, une cible relative ferait
  #    apparaître un ":443" dans l'en-tête Location.
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ https://www.athenamilitaria.fr/ [R=301,L]

  # 3. /page.html -> /page en 301 : les URLs déjà indexées par Google
  #    et les anciens liens partagés basculent vers la version propre.
  RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.html[\s?] [NC]
  RewriteRule ^ https://www.athenamilitaria.fr/%1 [R=301,L]

  # 4. Slash final retiré : /about/ et /about sont sinon deux URLs distinctes
  #    servant le même contenu, et les ressources relatives s'y résolvent mal.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/$ https://www.athenamilitaria.fr/$1 [R=301,L]

  # 5. /404 doit répondre un vrai code 404 et non un 200 sur une page d'erreur,
  #    sinon les moteurs la classent en soft 404.
  RewriteRule ^404/?$ - [R=404,L]

  # 5 bis. Index des guides.
  #   guides/ est un vrai répertoire : sans ces deux règles, Apache redirige
  #   /guides vers /guides/ pour y ajouter le slash, alors que la balise
  #   canonical de la page annonce /guides sans slash. On obtenait donc une
  #   canonical pointant vers une URL qui redirige, et deux adresses pour une
  #   seule page. La règle 4 ne rattrape pas le cas : elle exclut les
  #   répertoires.
  RewriteRule ^guides/$ https://www.athenamilitaria.fr/guides [R=301,L]

  # 5 bis (suite). Version anglaise des guides.
  #   Le corps des articles ne pouvait pas être traduit à l'exécution : le
  #   sommaire, ses ancres et les données structurées sont calculés à partir du
  #   texte, et auraient continué de décrire la version française. On sert donc
  #   un fichier distinct, cohérent de bout en bout, écrit par build-guides.js
  #   dans guides/en/.
  #   La condition -f est essentielle : un guide non traduit n'a pas de fichier
  #   anglais, la règle ne s'applique pas et le visiteur reçoit le français
  #   plutôt qu'une erreur.
  #   Ces deux règles précèdent celles du français : sans quoi la réécriture
  #   vers guides/index.html serait appliquée la première et la langue ignorée.
  RewriteCond %{QUERY_STRING} (^|&)lang=en($|&)
  RewriteCond %{DOCUMENT_ROOT}/guides/en/index.html -f
  RewriteRule ^guides/?$ guides/en/index.html [L]

  RewriteCond %{QUERY_STRING} (^|&)lang=en($|&)
  RewriteCond %{DOCUMENT_ROOT}/guides/en/$1.html -f
  RewriteRule ^guides/([^/]+?)/?$ guides/en/$1.html [L]

  RewriteRule ^guides$ guides/index.html [L]

  # 5 ter. Sitemap des annonces servi par PHP.
  #   sitemap.xml est un index qui renvoie vers deux fichiers : les pages
  #   (statique, écrit au déploiement) et les annonces. Ces dernières changent
  #   tous les jours, on ne peut pas attendre le déploiement suivant pour les
  #   déclarer : sitemap.php interroge la fonction Supabase et met le résultat
  #   en cache. L'URL reste sur le domaine, aucune redirection vers supabase.co.
  RewriteRule ^sitemap-annonces\.xml$ sitemap.php [L]

  # 5 quater. Coulisses du rendu serveur.
  #   inc/ contient la bibliothèque PHP et ses tables, cache/ les réponses de
  #   la base gardées quelques minutes. Rien de tout cela n'a à être servi.
  RewriteRule ^(inc|cache)(/|$) - [F,L]

  #   Les relais PHP ne répondent qu'à l'adresse publique de leur page :
  #   /product.php?id=21 ferait sinon doublon avec /product?id=21. On teste la
  #   requête d'origine (THE_REQUEST), que les réécritures suivantes ne
  #   modifient pas.
  RewriteCond %{THE_REQUEST} \s/+(product|category|page|media)\.php[\s?/] [NC]
  RewriteRule ^ - [R=404,L]

  # 5 quinquies. Pages rendues côté serveur.
  #   Les gabarits HTML restent les mêmes fichiers ; le relais PHP y écrit ce
  #   que le JavaScript ajoutait après coup, pour que les moteurs le lisent
  #   dès le HTML servi. La requête d'origine est transmise telle quelle.
  #
  #   Accueil : dernières annonces à jour (page.php).
  RewriteRule ^$ page.php [L]

  #   Versions anglaises des pages fixes, traduites avant envoi (page.php).
  #   Les versions françaises restent des fichiers servis directement.
  RewriteCond %{QUERY_STRING} (^|&)lang=en($|&)
  RewriteRule ^(about|community|sell|legal)$ page.php [L]

  #   Catalogue (category.php) : validation de la période et du type, choix
  #   de la copie enrichie d'après inc/categories.json, grille des annonces.
  #   Remplace les seize règles qui choisissaient la copie ici même.
  #   Adresses : /militaria, /militaria/<période>, /militaria/<période>/<type>.
  #   /category, l'ancienne adresse (?cat=…&sub=…), y passe aussi : le script
  #   la redirige en 301 vers la nouvelle. Tout chemin sous /militaria lui
  #   est confié, pour qu'un segment inconnu reçoive la 404 du site.
  #   /ventes, l'archive des ventes, est servie par le même script.
  RewriteRule ^(militaria(/.*)?|category|ventes)$ category.php [L]

  #   Fiche article (product.php) : balisage complet de l'annonce, 404 si
  #   elle n'existe pas, 301 vers le catalogue sans identifiant.
  #   Adresse : /annonce/<titre>-<identifiant>. Le titre se lit dans un lien
  #   partagé et dit de quoi il s'agit avant le clic ; l'identifiant, à la
  #   fin, désigne l'annonce. Tout ce qui commence par /annonce est confié au
  #   script, pour qu'une adresse mal formée reçoive la 404 du site plutôt
  #   que celle d'Apache. /product?id=… , l'ancienne adresse, y passe aussi :
  #   le script la redirige en 301, de même qu'un titre corrigé depuis.
  RewriteRule ^(annonce(/.*)?|product)$ product.php [L]

  #   Photos d'annonce en WebP. Le fichier est servi directement s'il existe
  #   déjà ; sinon media.php le fabrique et l'enregistre à cette adresse.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^media/(400|800|1200)/([0-9a-f-]{36}/[A-Za-z0-9._-]+\.webp)$ media.php?w=$1&p=$2 [L]

  # 6. /page est servi par page.html, sans changer l'URL affichée.
  #
  #    Le motif n'accepte QU'UN SEUL segment. La version précédente, ^(.+?)/?$,
  #    provoquait une boucle de réécriture sur toute URL imbriquée : sur
  #    /about/style.css, Apache résolvait le nom de fichier sur /about, trouvait
  #    about.html, réécrivait vers about/style.css.html, et recommençait
  #    jusqu'à l'erreur 500. Toute page visitée avec un slash final chargeait
  #    donc son CSS et son JS en 500.
  #    On teste aussi la présence du fichier depuis la racine documentaire
  #    plutôt que via REQUEST_FILENAME, qui est faussé par le PATH_INFO.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+?)/?$ $1.html [L]

  # 7. Guides éditoriaux : /guides/mon-guide sert guides/mon-guide.html.
  #    Règle séparée et volontairement limitée au dossier guides/ : élargir la
  #    règle 6 à plusieurs segments recréerait la boucle de réécriture qui
  #    renvoyait des 500 sur toute URL imbriquée.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/guides/$1.html -f
  RewriteRule ^guides/([^/]+?)/?$ guides/$1.html [L]
</IfModule>

# ---- Cache navigateur ----
# Les CSS/JS sont versionnés (style.css?v=82) : un cache long est sûr,
# une nouvelle version change l'URL et casse le cache automatiquement.
# ---- Compression Brotli, si le module existe ----
# Environ 15 % de moins que gzip sur le CSS et le JavaScript. Le bloc est
# ignoré sans erreur si mod_brotli n'est pas chargé chez l'hébergeur.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/javascript         "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  # Le HTML doit rester frais : le contenu change souvent
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Ressources statiques : cache long et immuable
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML : toujours revalidé pour que les mises à jour soient visibles
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # robots.txt et sitemap.xml changent à chaque déploiement mais sont relus
  # très souvent par les robots : une heure de cache évite la revalidation
  # systématique sans retarder la prise en compte des nouvelles annonces.
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # ---- En-têtes de sécurité (signaux de confiance) ----
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

  # HSTS : le site force déjà HTTPS par redirection plus haut ; on demande au
  # navigateur de ne plus jamais tenter le clair. Un an.
  #
  # Volontairement sans includeSubDomains ni preload : les deux s'appliqueraient
  # à des sous-domaines qui n'existent pas encore, et « preload » s'inscrit dans
  # les navigateurs eux-mêmes, ce qui est très long à défaire. Le gain de
  # sécurité marginal ne vaut pas ce risque d'enfermement.
  Header always set Strict-Transport-Security "max-age=31536000"

  # ---- Politique de sécurité du contenu ----
  #
  # Ce que cette politique protège réellement : l'exfiltration. Si du code
  # étranger parvenait à s'exécuter sur une page (annonce piégée, dépendance
  # compromise), connect-src et form-action l'empêchent d'envoyer quoi que ce
  # soit ailleurs que vers nos propres domaines.
  #
  # 'unsafe-inline' sur les scripts est assumé : les pages portent des scripts
  # en ligne (état de connexion appliqué avant le premier rendu) et des
  # attributs onerror sur les images. Les retirer demanderait de réécrire
  # l'ensemble du site, avec un risque de régression bien supérieur au gain.
  # La politique reste utile sans cela.
  #
  # Le paiement lui-même n'est pas concerné : Stripe Checkout est une page
  # hébergée par Stripe, atteinte par redirection de navigation. Aucune donnée
  # de carte ne transite jamais par une page de ce domaine, ce qui maintient
  # l'intégration hors du périmètre le plus lourd de PCI DSS.
  <FilesMatch "\.(html|php)$">
  # Le joker sur google-analytics.com n'est pas de la paresse : dans l'Espace
  # économique européen, GA4 n'envoie pas ses mesures à www.google-analytics.com
  # mais à un sous-domaine régional, region1.google-analytics.com. Sans lui, le
  # script se chargeait et la collecte était refusée en silence, ce qui ne se
  # voit que dans la console.
  # googletagmanager.com et google-analytics.com sont ouverts pour la mesure
  # d'audience (analytics.js), qui ne charge rien avant un accord explicite du
  # visiteur. Ces domaines figurent dans la politique dès maintenant pour une
  # raison pratique : un refus de CSP ne se voit que dans la console, et la
  # mesure aurait paru fonctionner tout en n'enregistrant rien.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://uctaxgfqdoxtcidllyjv.supabase.co https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://uctaxgfqdoxtcidllyjv.supabase.co https://cdn.jsdelivr.net https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com; form-action 'self' https://checkout.stripe.com; frame-src https://checkout.stripe.com https://js.stripe.com; upgrade-insecure-requests"
  </FilesMatch>

  # La page de confirmation de commande, et elle seule, accueille l'enquête
  # Google Avis clients : le script vient d'apis.google.com (avec des modules
  # sur gstatic.com) et la boîte de dialogue est une iframe servie par
  # google.com. Élargir la politique globale pour une seule page aurait offert
  # ces domaines comme canal d'exfiltration à tout le site ; l'élargissement
  # est donc confiné ici. Ce bloc vient après le FilesMatch général : pour un
  # même en-tête, c'est la dernière directive « set » qui l'emporte.
  <Files "order.html">
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://uctaxgfqdoxtcidllyjv.supabase.co https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://uctaxgfqdoxtcidllyjv.supabase.co https://cdn.jsdelivr.net https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com; form-action 'self' https://checkout.stripe.com; frame-src https://checkout.stripe.com https://js.stripe.com https://www.google.com; upgrade-insecure-requests"
  </Files>
</IfModule>

# ---- Compression (déjà active chez OVH, sécurisé par IfModule) ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  # application/xml est indispensable : le bloc mod_mime plus bas force ce
  # type sur les .xml, si bien que sitemap.xml n'était pas compressé du tout.
  AddOutputFilterByType DEFLATE application/xml application/manifest+json
</IfModule>

# ---- Types MIME corrects (indexation et rendu) ----
<IfModule mod_mime.c>
  AddType application/xml   .xml
  AddType image/webp        .webp
  AddType font/woff2        .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
